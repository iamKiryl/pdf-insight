{
  // CANDIDATE replacement for the Python Worker (backend/wrangler.jsonc), prepared for review.
  // It deploys to the SAME Worker name with the same AI binding and rate-limit namespaces, so a
  // deploy REPLACES the production Python runtime. Do not run `wrangler deploy` here until the
  // migration is approved (docs/RUNTIME.md). The Python fallback is deployed from backend/ with
  // `uv run pywrangler deploy` only.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf-insight-api",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-05",
  // One zod copy: the shared result schema lives in frontend/src/lib but must use this package.
  "alias": { "zod": "./node_modules/zod" },
  "ai": { "binding": "AI" },
  "ratelimits": [
    { "name": "ANALYZE_IP_LIMITER", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ANALYZE_GLOBAL_LIMITER", "namespace_id": "41002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    "ENVIRONMENT": "production",
    "ALLOWED_ORIGINS": "https://iamkiryl.github.io",
    "MAX_BODY_BYTES": "262144",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    "AI_MODE": "compact",
    "AI_TIMEOUT_SECONDS": "40",
    "AI_TOTAL_BUDGET_SECONDS": "55",
    "AI_MAX_TOKENS": "2048"
  },
  "observability": { "enabled": true }
}
