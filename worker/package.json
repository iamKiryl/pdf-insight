{
  "name": "pdf-insight-worker",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Compact-mode PDF Insight API as a TypeScript Cloudflare Worker (candidate replacement for backend/, not deployed).",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.test.json",
    "test": "vitest run",
    "build": "wrangler deploy --dry-run --outdir dist",
    "dev": "wrangler dev"
  },
  "dependencies": {
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261006.1",
    "@types/node": "22.20.5",
    "typescript": "6.0.3",
    "vitest": "5.0.3",
    "wrangler": "4.147.0"
  }
}
