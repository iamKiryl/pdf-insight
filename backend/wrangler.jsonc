{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "pdf-insight-api",
  "main": "src/worker.py",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["python_workers"],
  // Workers AI binding: no model API key exists in code, config or the browser.
  "ai": { "binding": "AI" },
  // Shared rate limiting (Cloudflare Rate Limiting binding). Counters are per Cloudflare location
  // and eventually consistent; period must be 10 or 60 seconds. namespace_id is an account-unique
  // integer chosen by us.
  "ratelimits": [
    { "name": "ANALYZE_IP_LIMITER", "namespace_id": "41001", "simple": { "limit": 5, "period": 60 } },
    { "name": "ANALYZE_GLOBAL_LIMITER", "namespace_id": "41002", "simple": { "limit": 30, "period": 60 } }
  ],
  "vars": {
    // Anything except "development" is treated as production (fail closed).
    "ENVIRONMENT": "production",
    // Comma-separated browser origins (scheme + host, no path), e.g. https://<user>.github.io
    "ALLOWED_ORIGINS": "",
    "MAX_BODY_BYTES": "262144",
    "AI_MODEL": "@cf/meta/llama-3.3-70b-instruct-fp8-fast",
    // Failure ceilings (not a latency target): one model call ≤ 40 s, all calls of a request ≤ 55 s.
    "AI_TIMEOUT_SECONDS": "40",
    "AI_TOTAL_BUDGET_SECONDS": "55",
    "AI_MAX_TOKENS": "2048"
  },
  "observability": { "enabled": true }
}
